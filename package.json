{
  "name": "la-cour-de-haut",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.10.0",
  "scripts": {
    "dev": "next dev",
    "build": "pnpm db:migrate && next build",
    "start": "pnpm db:migrate && pnpm seed-owner && next start",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate && pnpm run backfill-gallery-dimensions && pnpm run seed-property-settings && pnpm run seed-pages",
    "seed-owner": "tsx scripts/seed-owner.mts",
    "seed-ical-sources": "tsx scripts/seed-ical-sources.mts",
    "seed-property-settings": "tsx scripts/seed-property-settings.mts",
    "seed-pages": "tsx scripts/seed-pages.mts",
    "backfill-gallery-dimensions": "tsx scripts/backfill-gallery-dimensions.mts",
    "migrate-content-blocks-to-rich-text": "tsx scripts/migrate-content-blocks-to-rich-text.mts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "doctor": "react-doctor --yes --no-telemetry ."
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@google-cloud/translate": "^9.4.2",
    "@lexical/headless": "^0.46.0",
    "@lexical/html": "^0.46.0",
    "@lexical/link": "^0.46.0",
    "@lexical/list": "^0.46.0",
    "@lexical/react": "^0.46.0",
    "@lexical/rich-text": "^0.46.0",
    "@lexical/utils": "^0.46.0",
    "@marsidev/react-turnstile": "^1.6.1",
    "@neondatabase/serverless": "^1.1.0",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tanstack/react-form-nextjs": "^1.33.5",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.8.0",
    "@vercel/functions": "3.7.6",
    "better-auth": "^1.7.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.3",
    "happy-dom": "^20.14.5",
    "ibantools": "^4.5.4",
    "intl-messageformat": "^11.2.15",
    "lexical": "^0.46.0",
    "libphonenumber-js": "^1.13.13",
    "lucide-react": "^1.47.0",
    "next": "16.3.5",
    "node-ical": "^0.26.1",
    "react": "19.3.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.3.0",
    "resend": "^6.28.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.13.6",
    "@types/probe-image-size": "^7.2.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "babel-plugin-react-compiler": "1.0.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.5",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^29.1.1",
    "lefthook": "2.1.14",
    "prettier": "^3.9.8",
    "probe-image-size": "^7.4.0",
    "react-doctor": "0.7.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.11"
  }
}
